#!/usr/bin/env bash
#
# fedora-update - Sammel-Update für Fedora KDE
#
# Aktualisiert konsistent RPM-Pakete (dnf), Flatpaks und Firmware (fwupd)
# und synchronisiert danach den Discover-Cache, damit der Update-Zähler
# in Discover nicht auseinanderläuft.
#
# Verwendung:
#   fedora-update              interaktiv (fragt vor Firmware-Update nach)
#   fedora-update --yes        vollautomatisch, keine Rückfragen
#   fedora-update --no-firmware  Firmware-Updates überspringen
#   fedora-update --dry-run    nur anzeigen, was zu tun wäre
#

set -uo pipefail

# ---------------------------------------------------------------- Konstanten

readonly VERSION="1.0.1"
readonly LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/fedora-update"
LOGFILE="${LOGDIR}/$(date +%Y-%m-%d_%H%M%S).log"
readonly LOGFILE
readonly LOG_KEEP=20

ASSUME_YES=0
SKIP_FIRMWARE=0
DRY_RUN=0
REBOOT_NEEDED=0

declare -a RESULTS=()

# ------------------------------------------------------------------ Ausgabe

if [[ -t 1 ]]; then
	C_RESET=$'\033[0m'
	C_BOLD=$'\033[1m'
	C_DIM=$'\033[2m'
	C_BLUE=$'\033[34m'
	C_GREEN=$'\033[32m'
	C_YELLOW=$'\033[33m'
	C_RED=$'\033[31m'
else
	C_RESET='' C_BOLD='' C_DIM='' C_BLUE='' C_GREEN='' C_YELLOW='' C_RED=''
fi

log() { printf '%s\n' "$*" >>"$LOGFILE"; }

section() {
	printf '\n%s%s▌ %s%s\n' "$C_BOLD" "$C_BLUE" "$1" "$C_RESET"
	printf '%s%s%s\n' "$C_DIM" "$(printf '─%.0s' $(seq 1 60))" "$C_RESET"
	log ""
	log "=== $1 ==="
}

ok()   { printf '%s✔%s %s\n' "$C_GREEN" "$C_RESET" "$1"; log "[ OK ] $1"; }
warn() { printf '%s▲%s %s\n' "$C_YELLOW" "$C_RESET" "$1"; log "[WARN] $1"; }
fail() { printf '%s✘%s %s\n' "$C_RED" "$C_RESET" "$1"; log "[FAIL] $1"; }
info() { printf '%s  %s%s\n' "$C_DIM" "$1" "$C_RESET"; log "[INFO] $1"; }

# Führt einen Befehl aus, protokolliert ihn und zeigt ihn gleichzeitig an.
run() {
	log "\$ $*"
	if (( DRY_RUN )); then
		printf '%s  [dry-run] %s%s\n' "$C_DIM" "$*" "$C_RESET"
		return 0
	fi
	"$@" 2>&1 | tee -a "$LOGFILE"
	return "${PIPESTATUS[0]}"
}

ask() {
	local prompt="$1"
	(( ASSUME_YES )) && return 0
	(( DRY_RUN )) && return 1
	local answer
	# Explizit vom Terminal lesen, damit die Abfrage auch funktioniert,
	# wenn stdin umgeleitet ist. Ohne Terminal gilt die Antwort als Nein.
	read -r -p "$(printf '%s?%s %s [j/N] ' "$C_YELLOW" "$C_RESET" "$prompt")" answer </dev/tty 2>/dev/null || return 1
	[[ "$answer" =~ ^([jJ]|[yY])$ ]]
}

# --------------------------------------------------------------- Argumente

while (( $# )); do
	case "$1" in
		-y|--yes)         ASSUME_YES=1 ;;
		--no-firmware)    SKIP_FIRMWARE=1 ;;
		-n|--dry-run)     DRY_RUN=1 ;;
		-V|--version)     printf 'fedora-update %s\n' "$VERSION"; exit 0 ;;
		-h|--help)
			sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
			exit 0
			;;
		*)
			printf 'Unbekannte Option: %s (siehe --help)\n' "$1" >&2
			exit 2
			;;
	esac
	shift
done

# ------------------------------------------------------------ Vorbereitung

mkdir -p "$LOGDIR"
: >"$LOGFILE"

printf '\n%s%s  Fedora Sammel-Update%s  %sv%s%s\n' \
	"$C_BOLD" "$C_BLUE" "$C_RESET" "$C_DIM" "$VERSION" "$C_RESET"
printf '%s  %s · %s%s\n' "$C_DIM" "$(hostname)" "$(date '+%d.%m.%Y %H:%M')" "$C_RESET"
(( DRY_RUN )) && printf '%s  ── Testlauf, es wird nichts verändert ──%s\n' "$C_YELLOW" "$C_RESET"

log "fedora-update $VERSION – $(date -Is) – $(hostname)"

if [[ $EUID -eq 0 ]]; then
	fail "Bitte nicht als root starten – das Script ruft sudo selbst auf."
	exit 1
fi

# Sudo einmal vorab anfordern und die Sitzung offen halten, damit während
# eines langen Downloads keine Passwortabfrage dazwischenfunkt.
if ! (( DRY_RUN )); then
	if ! sudo -v; then
		fail "sudo-Authentifizierung fehlgeschlagen."
		exit 1
	fi
	while true; do
		sudo -n true
		sleep 50
		kill -0 "$$" 2>/dev/null || exit
	done &
	readonly SUDO_KEEPALIVE_PID=$!
	trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null' EXIT
fi

# ------------------------------------------------------- 1. RPM-Pakete (dnf)

section "1/4  Systempakete (dnf)"

if command -v dnf >/dev/null 2>&1; then
	dnf_args=(upgrade --refresh)
	(( ASSUME_YES )) && dnf_args+=(-y)
	if run sudo dnf "${dnf_args[@]}"; then
		ok "Systempakete aktualisiert"
		RESULTS+=("dnf: OK")
	else
		fail "dnf upgrade mit Fehler beendet"
		RESULTS+=("dnf: FEHLER")
	fi

	# Verwaiste Abhängigkeiten aufräumen
	if (( ASSUME_YES )); then
		run sudo dnf autoremove -y >/dev/null && info "Verwaiste Pakete entfernt"
	fi

	# Prüfen, ob ein Neustart nötig ist (Kernel, systemd, glibc, ...)
	if command -v needs-restarting >/dev/null 2>&1; then
		needs-restarting -r >/dev/null 2>&1 || REBOOT_NEEDED=1
	fi
else
	warn "dnf nicht gefunden – übersprungen"
	RESULTS+=("dnf: n/v")
fi

# --------------------------------------------------------- 2. Flatpak-Apps

section "2/4  Flatpak-Anwendungen"

if command -v flatpak >/dev/null 2>&1; then
	# flatpak darf hier nie selbst nachfragen: Durch die Ausgabe über tee
	# sieht es kein Terminal, wertet seine [Y/n]-Abfrage als «n» und bricht
	# mit Fehler ab. Darum zuerst selbst prüfen und bestätigen lassen, danach
	# nicht-interaktiv aktualisieren.
	info "Suche nach Aktualisierungen …"
	fp_updates=$(flatpak remote-ls --updates --columns=application,branch,origin 2>/dev/null)

	if [[ -z "$fp_updates" ]]; then
		ok "Alle Flatpaks sind aktuell"
		RESULTS+=("flatpak: aktuell")
	else
		fp_count=$(grep -c . <<<"$fp_updates")
		printf '\n'
		printf '%s\n' "$fp_updates" | column -t 2>/dev/null || printf '%s\n' "$fp_updates"
		printf '\n'
		log "$fp_updates"

		if (( DRY_RUN )) || ask "${fp_count} Flatpak-Aktualisierung(en) installieren?"; then
			if run flatpak update -y --noninteractive; then
				ok "Flatpaks aktualisiert"
				RESULTS+=("flatpak: OK")
			else
				fail "flatpak update mit Fehler beendet"
				RESULTS+=("flatpak: FEHLER")
			fi
		else
			info "Flatpak-Update ausgelassen"
			RESULTS+=("flatpak: verfügbar, nicht installiert")
		fi
	fi

	# Nicht mehr benötigte Runtimes entfernen – die sammeln sich sonst an
	# und belegen schnell mehrere Gigabyte.
	if (( ASSUME_YES )); then
		run flatpak uninstall --unused -y --noninteractive >/dev/null && info "Ungenutzte Runtimes entfernt"
	else
		if ask "Ungenutzte Flatpak-Runtimes entfernen?"; then
			run flatpak uninstall --unused -y --noninteractive
		fi
	fi
else
	warn "flatpak nicht gefunden – übersprungen"
	RESULTS+=("flatpak: n/v")
fi

# ------------------------------------------------------------- 3. Firmware

section "3/4  Firmware (fwupd)"

if (( SKIP_FIRMWARE )); then
	info "Auf Wunsch übersprungen (--no-firmware)"
	RESULTS+=("firmware: übersprungen")
elif command -v fwupdmgr >/dev/null 2>&1; then
	run fwupdmgr refresh --force >/dev/null 2>&1 || true

	if fwupdmgr get-updates >/dev/null 2>&1; then
		printf '\n'
		fwupdmgr get-updates 2>/dev/null | tee -a "$LOGFILE"
		printf '\n'

		# Firmware-Updates brauchen Netzstrom und einen Neustart, darum
		# hier bewusst eine eigene Rückfrage.
		if on_ac=$(cat /sys/class/power_supply/A{C,DP}*/online 2>/dev/null | head -1); then
			if [[ "$on_ac" != "1" ]]; then
				warn "Kein Netzteil angeschlossen – Firmware-Update wird nicht empfohlen."
			fi
		fi

		if ask "Firmware jetzt aktualisieren? (Neustart erforderlich)"; then
			fw_args=(update)
			(( ASSUME_YES )) && fw_args+=(-y --no-reboot-check)
			if run sudo fwupdmgr "${fw_args[@]}"; then
				ok "Firmware eingespielt"
				RESULTS+=("firmware: OK – Neustart nötig")
				REBOOT_NEEDED=1
			else
				fail "Firmware-Update mit Fehler beendet"
				RESULTS+=("firmware: FEHLER")
			fi
		else
			info "Firmware-Update ausgelassen"
			RESULTS+=("firmware: verfügbar, nicht installiert")
		fi
	else
		ok "Keine Firmware-Updates verfügbar"
		RESULTS+=("firmware: aktuell")
	fi
else
	warn "fwupdmgr nicht gefunden – übersprungen"
	RESULTS+=("firmware: n/v")
fi

# ------------------------------------------------- 4. Discover synchronisieren

section "4/4  Discover-Cache abgleichen"

# Discover führt einen eigenen Cache und bekommt Terminal-Updates nicht mit.
# Ohne diesen Schritt zeigt der Notifier veraltete Update-Zahlen an und
# bleibt beim Aktualisieren hängen.
if command -v plasma-discover >/dev/null 2>&1; then
	if ! (( DRY_RUN )); then
		kquitapp6 DiscoverNotifier >/dev/null 2>&1 || true
		pkill -x plasma-discover >/dev/null 2>&1 || true
		sleep 1

		rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/discover" \
		       "${XDG_CACHE_HOME:-$HOME/.cache}/appstream" \
		       "${XDG_CACHE_HOME:-$HOME/.cache}/flatpak/system-cache" 2>/dev/null || true

		command -v appstreamcli >/dev/null 2>&1 && appstreamcli refresh --force >/dev/null 2>&1

		# Notifier abgekoppelt wieder starten, damit er nicht am Script hängt
		if command -v DiscoverNotifier >/dev/null 2>&1; then
			(setsid DiscoverNotifier >/dev/null 2>&1 &)
		fi
	fi
	ok "Discover-Cache zurückgesetzt"
	RESULTS+=("discover: synchronisiert")
else
	info "Discover nicht installiert – nichts abzugleichen"
fi

# ------------------------------------------------------------ Zusammenfassung

section "Zusammenfassung"

for line in "${RESULTS[@]}"; do
	printf '  • %s\n' "$line"
	log "  • $line"
done

printf '\n%s  Protokoll: %s%s\n' "$C_DIM" "$LOGFILE" "$C_RESET"

if (( REBOOT_NEEDED )); then
	printf '\n%s%s  ⟳ Ein Neustart ist erforderlich.%s\n' "$C_BOLD" "$C_YELLOW" "$C_RESET"
fi

# Alte Protokolle aufräumen
if [[ -d "$LOGDIR" ]]; then
	find "$LOGDIR" -maxdepth 1 -name '*.log' -type f -printf '%T@ %p\n' 2>/dev/null \
		| sort -rn | tail -n +$((LOG_KEEP + 1)) | cut -d' ' -f2- \
		| xargs -r rm -f
fi

printf '\n'

# Beim Start aus dem Anwendungsmenü würde sich das Fenster sofort schliessen.
if [[ -t 0 ]] && [[ -n "${FEDORA_UPDATE_PAUSE:-}" ]]; then
	read -r -p "Zum Schliessen Enter drücken ... " _
fi
