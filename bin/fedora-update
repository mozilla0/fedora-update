#!/usr/bin/env bash
#
# fedora-update - Sammel-Update für Fedora KDE
#
# Aktualisiert konsistent RPM-Pakete (dnf), Flatpaks und Firmware (fwupd)
# und synchronisiert danach den Discover-Cache, damit der Update-Zähler
# in Discover nicht auseinanderläuft.
#
# Ist die Systemfestplatte mit LUKS verschlüsselt und per systemd-cryptenroll
# an das TPM gebunden (PCR 7), prüft das Script bei jedem Lauf, ob die
# TPM-Entsperrung noch funktioniert, und richtet sie nach Firmware-Updates
# auf Wunsch neu ein.
#
# Verwendung:
#   fedora-update                interaktiv (fragt vor Firmware-Update nach)
#   fedora-update --yes          vollautomatisch, keine Rückfragen
#   fedora-update --no-firmware  Firmware-Updates überspringen
#   fedora-update --no-tpm       TPM-/LUKS-Prüfung überspringen
#   fedora-update --tpm-check    nur TPM-Entsperrung prüfen und neu einrichten
#   fedora-update --dry-run      nur anzeigen, was zu tun wäre
#
# Umgebungsvariable FEDORA_UPDATE_TPM_PCRS legt die PCRs für die
# Neuanmeldung fest (Standard: 7).
#

set -uo pipefail

# ---------------------------------------------------------------- Konstanten

readonly VERSION="1.1.1"
readonly LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/fedora-update"
LOGFILE="${LOGDIR}/$(date +%Y-%m-%d_%H%M%S).log"
readonly LOGFILE
readonly LOG_KEEP=20
readonly TPM_PCRS="${FEDORA_UPDATE_TPM_PCRS:-7}"

ASSUME_YES=0
SKIP_FIRMWARE=0
DRY_RUN=0
SKIP_TPM=0
TPM_ONLY=0
REBOOT_NEEDED=0

declare -a RESULTS=()
declare -a TPM_DEVICES=()

# ------------------------------------------------------------------ Ausgabe

if [[ -t 1 ]]; then
	C_RESET=$'\033[0m'
	C_BOLD=$'\033[1m'
	C_DIM=$'\033[2m'
	C_BLUE=$'\033[34m'
	C_GREEN=$'\033[32m'
	C_YELLOW=$'\033[33m'
	C_RED=$'\033[31m'
else
	C_RESET='' C_BOLD='' C_DIM='' C_BLUE='' C_GREEN='' C_YELLOW='' C_RED=''
fi

log() { printf '%s\n' "$*" >>"$LOGFILE"; }

section() {
	printf '\n%s%s▌ %s%s\n' "$C_BOLD" "$C_BLUE" "$1" "$C_RESET"
	printf '%s%s%s\n' "$C_DIM" "$(printf '─%.0s' $(seq 1 60))" "$C_RESET"
	log ""
	log "=== $1 ==="
}

ok()   { printf '%s✔%s %s\n' "$C_GREEN" "$C_RESET" "$1"; log "[ OK ] $1"; }
warn() { printf '%s▲%s %s\n' "$C_YELLOW" "$C_RESET" "$1"; log "[WARN] $1"; }
fail() { printf '%s✘%s %s\n' "$C_RED" "$C_RESET" "$1"; log "[FAIL] $1"; }
info() { printf '%s  %s%s\n' "$C_DIM" "$1" "$C_RESET"; log "[INFO] $1"; }

# Führt einen Befehl aus, protokolliert ihn und zeigt ihn gleichzeitig an.
run() {
	log "\$ $*"
	if (( DRY_RUN )); then
		printf '%s  [dry-run] %s%s\n' "$C_DIM" "$*" "$C_RESET"
		return 0
	fi
	"$@" 2>&1 | tee -a "$LOGFILE"
	return "${PIPESTATUS[0]}"
}

ask() {
	local prompt="$1"
	(( ASSUME_YES )) && return 0
	(( DRY_RUN )) && return 1
	local answer
	# Explizit vom Terminal lesen, damit die Abfrage auch funktioniert,
	# wenn stdin umgeleitet ist. Ohne Terminal gilt die Antwort als Nein.
	{ : </dev/tty; } 2>/dev/null || return 1
	read -r -p "$(printf '%s?%s %s [j/N] ' "$C_YELLOW" "$C_RESET" "$prompt")" answer </dev/tty || return 1
	[[ "$answer" =~ ^([jJ]|[yY])$ ]]
}

# -------------------------------------------------------------- TPM / LUKS
#
# Hintergrund: systemd-cryptenroll versiegelt den LUKS-Schlüssel gegen
# bestimmte PCR-Werte des TPM. PCR 7 bildet den Secure-Boot-Zustand ab
# (Schlüssel, db/dbx). Spielt fwupd z. B. ein UEFI-dbx- oder BIOS-Update ein,
# ändert sich PCR 7, das TPM gibt den Schlüssel nicht mehr frei und beim Start
# wird die Passphrase verlangt. Die Daten sind dabei nie verloren, solange
# noch ein Passwort- oder Recovery-Slot existiert – die TPM-Bindung muss nur
# gegen die neuen PCR-Werte neu angelegt werden.

# Hinweis: Ausgaben werden erst in Variablen gelesen und dann geprüft.
# Ein direktes «befehl | grep -q» kann wegen pipefail zufällig fehlschlagen,
# wenn grep früh beendet und der Befehl davor SIGPIPE erhält.

# Findet alle LUKS-Geräte mit einem systemd-tpm2-Token.
tpm_find_devices() {
	TPM_DEVICES=()
	local dev dump
	while read -r dev; do
		[[ -n "$dev" ]] || continue
		dump=$(sudo -n cryptsetup luksDump "$dev" 2>/dev/null) || continue
		if [[ "$dump" == *systemd-tpm2* ]]; then
			TPM_DEVICES+=("$dev")
		fi
	done < <(lsblk -rpno NAME,FSTYPE 2>/dev/null | awk '$2 == "crypto_LUKS" { print $1 }')
}

# Ist die TPM-Bindung zusätzlich mit einer PIN geschützt?
tpm_uses_pin() {
	local dump
	dump=$(sudo -n cryptsetup luksDump "$1" 2>/dev/null) || return 1
	grep -Eq 'tpm2-pin:[[:space:]]*true' <<<"$dump"
}

# Prüft ohne Einhängen, ob das TPM das Gerät mit den aktuellen PCR-Werten
# entsperren könnte.
tpm_unlock_ok() {
	sudo -n cryptsetup open --test-passphrase --token-only \
		--token-type systemd-tpm2 "$1" </dev/null >/dev/null 2>&1
}

# Wie tpm_unlock_ok, aber für TPM-Bindungen mit PIN: cryptsetup fragt die
# PIN selbst am Terminal ab.
tpm_unlock_ok_pin() {
	# shellcheck disable=SC2024
	sudo cryptsetup open --test-passphrase --token-only \
		--token-type systemd-tpm2 "$1" </dev/tty
}

# Gibt es neben dem TPM noch eine Passphrase oder einen Recovery-Key?
tpm_has_fallback() {
	local slots
	slots=$(sudo -n systemd-cryptenroll "$1" 2>/dev/null) || return 1
	awk 'NR > 1 { print $2 }' <<<"$slots" | grep -Eqx 'password|recovery'
}

# Legt die TPM-Bindung gegen die aktuellen PCR-Werte neu an. Der alte
# TPM-Slot wird erst nach erfolgreicher Neuanmeldung entfernt. War die alte
# Bindung mit PIN geschützt, wird auch die neue wieder mit PIN angelegt.
tpm_reenroll() {
	local dev="$1" with_pin="$2"
	local -a args=(--wipe-slot=tpm2 --tpm2-device=auto --tpm2-pcrs="$TPM_PCRS")
	(( with_pin )) && args+=(--tpm2-with-pin=yes)
	log "\$ sudo systemd-cryptenroll ${args[*]} $dev"
	info "Zuerst die LUKS-Passphrase oder den Wiederherstellungsschlüssel für $dev eingeben."
	(( with_pin )) && info "Danach die TPM-PIN festlegen (du kannst die bisherige wieder verwenden)."
	# Die Eingabe soll bewusst vom Terminal kommen, nicht an sudo vorbei.
	# shellcheck disable=SC2024
	sudo systemd-cryptenroll "${args[@]}" "$dev" </dev/tty
}

# Bietet die Neuanmeldung an und prüft danach, ob sie funktioniert.
tpm_offer_reenroll() {
	local dev="$1" with_pin="$2"
	if (( DRY_RUN )); then
		info "[dry-run] sudo systemd-cryptenroll --wipe-slot=tpm2 --tpm2-device=auto --tpm2-pcrs=$TPM_PCRS $dev"
		return 1
	fi
	if ! ask "TPM-Bindung für $dev jetzt neu einrichten (PCR $TPM_PCRS)?"; then
		info "Ausgelassen – beim Start wird weiterhin die Passphrase verlangt"
		return 1
	fi
	if ! tpm_reenroll "$dev" "$with_pin"; then
		fail "$dev: Neuanmeldung am TPM fehlgeschlagen"
		return 1
	fi
	if (( with_pin )); then
		ok "$dev: TPM-Bindung mit PIN neu eingerichtet"
		return 0
	fi
	if tpm_unlock_ok "$dev"; then
		ok "$dev: TPM-Bindung neu eingerichtet"
		return 0
	fi
	fail "$dev: Neuanmeldung am TPM fehlgeschlagen"
	return 1
}

tpm_step() {
	section "$1"

	if (( SKIP_TPM )); then
		info "Auf Wunsch übersprungen (--no-tpm)"
		RESULTS+=("tpm: übersprungen")
		return 0
	fi
	if ! command -v cryptsetup >/dev/null 2>&1 || ! command -v systemd-cryptenroll >/dev/null 2>&1; then
		info "cryptsetup/systemd-cryptenroll nicht vorhanden – nichts zu prüfen"
		return 0
	fi
	if ! sudo -n true 2>/dev/null; then
		info "Ohne sudo-Sitzung nicht prüfbar (Testlauf) – übersprungen"
		RESULTS+=("tpm: nicht geprüft")
		return 0
	fi

	tpm_find_devices
	if (( ${#TPM_DEVICES[@]} == 0 )); then
		info "Keine an das TPM gebundenen LUKS-Geräte gefunden"
		return 0
	fi

	# Ohne das Token-Plugin kann cryptsetup die TPM-Entsperrung nicht testen
	# und würde fälschlich einen Fehler melden.
	if ! compgen -G '/usr/lib*/cryptsetup/libcryptsetup-token-systemd-tpm2.so' >/dev/null \
		&& ! compgen -G '/usr/lib/*/cryptsetup/libcryptsetup-token-systemd-tpm2.so' >/dev/null; then
		warn "cryptsetup-Plugin für systemd-tpm2 nicht gefunden – TPM-Entsperrung nicht prüfbar"
		RESULTS+=("tpm: nicht geprüft")
		return 0
	fi

	local dev failed=0 unchecked=0
	for dev in "${TPM_DEVICES[@]}"; do
		if tpm_uses_pin "$dev"; then
			# Mit PIN lässt sich die Entsperrung nur interaktiv testen. Im
			# normalen Update-Lauf wird darum nicht jedes Mal nach der PIN
			# gefragt, sondern nur mit --tpm-check.
			if (( ! TPM_ONLY || DRY_RUN || ASSUME_YES )); then
				info "$dev: TPM mit PIN – Prüfung nur mit «fedora-update --tpm-check»"
				unchecked=1
				continue
			fi
			if ! ask "TPM-Entsperrung für $dev jetzt mit der TPM-PIN testen?"; then
				info "$dev: Prüfung ausgelassen"
				unchecked=1
				continue
			fi
			info "Bitte die TPM-PIN eingeben (nicht die LUKS-Passphrase):"
			if tpm_unlock_ok_pin "$dev"; then
				ok "$dev: TPM-Entsperrung mit PIN funktioniert"
				continue
			fi
			warn "$dev: Entsperrung fehlgeschlagen – entweder war die PIN falsch oder die PCR-Werte haben sich geändert (z. B. nach einem Firmware-Update)."
			info "Bei falscher PIN einfach erneut «fedora-update --tpm-check» ausführen. Zu viele Fehlversuche sperren das TPM vorübergehend."
			tpm_offer_reenroll "$dev" 1 || failed=1
			continue
		fi

		if tpm_unlock_ok "$dev"; then
			ok "$dev: TPM-Entsperrung funktioniert"
			continue
		fi

		warn "$dev: Das TPM gibt den Schlüssel nicht mehr frei (PCR-Werte geändert, z. B. nach einem Firmware-Update)."
		tpm_offer_reenroll "$dev" 0 || failed=1
	done

	if (( failed )); then
		RESULTS+=("tpm: Neuanmeldung ausstehend (fedora-update --tpm-check)")
	elif (( unchecked )); then
		RESULTS+=("tpm: nicht geprüft (PIN) – bei Bedarf «fedora-update --tpm-check»")
	else
		RESULTS+=("tpm: OK")
	fi
}

# --------------------------------------------------------------- Argumente

while (( $# )); do
	case "$1" in
		-y|--yes)         ASSUME_YES=1 ;;
		--no-firmware)    SKIP_FIRMWARE=1 ;;
		--no-tpm)         SKIP_TPM=1 ;;
		--tpm-check)      TPM_ONLY=1 ;;
		-n|--dry-run)     DRY_RUN=1 ;;
		-V|--version)     printf 'fedora-update %s\n' "$VERSION"; exit 0 ;;
		-h|--help)
			sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'
			exit 0
			;;
		*)
			printf 'Unbekannte Option: %s (siehe --help)\n' "$1" >&2
			exit 2
			;;
	esac
	shift
done

# ------------------------------------------------------------ Zusammenfassung

finish() {
	section "Zusammenfassung"

	for line in "${RESULTS[@]}"; do
		printf '  • %s\n' "$line"
		log "  • $line"
	done

	printf '\n%s  Protokoll: %s%s\n' "$C_DIM" "$LOGFILE" "$C_RESET"

	if (( REBOOT_NEEDED )); then
		printf '\n%s%s  ⟳ Ein Neustart ist erforderlich.%s\n' "$C_BOLD" "$C_YELLOW" "$C_RESET"
	fi

	# Alte Protokolle aufräumen
	if [[ -d "$LOGDIR" ]]; then
		find "$LOGDIR" -maxdepth 1 -name '*.log' -type f -printf '%T@ %p\n' 2>/dev/null \
			| sort -rn | tail -n +$((LOG_KEEP + 1)) | cut -d' ' -f2- \
			| xargs -r rm -f
	fi

	printf '\n'

	# Beim Start aus dem Anwendungsmenü würde sich das Fenster sofort schliessen.
	if [[ -t 0 ]] && [[ -n "${FEDORA_UPDATE_PAUSE:-}" ]]; then
		read -r -p "Zum Schliessen Enter drücken ... " _
	fi
}

# ------------------------------------------------------------ Vorbereitung

mkdir -p "$LOGDIR"
: >"$LOGFILE"

printf '\n%s%s  Fedora Sammel-Update%s  %sv%s%s\n' \
	"$C_BOLD" "$C_BLUE" "$C_RESET" "$C_DIM" "$VERSION" "$C_RESET"
printf '%s  %s · %s%s\n' "$C_DIM" "$(hostname)" "$(date '+%d.%m.%Y %H:%M')" "$C_RESET"
(( DRY_RUN )) && printf '%s  ── Testlauf, es wird nichts verändert ──%s\n' "$C_YELLOW" "$C_RESET"

log "fedora-update $VERSION – $(date -Is) – $(hostname)"

if [[ $EUID -eq 0 ]]; then
	fail "Bitte nicht als root starten – das Script ruft sudo selbst auf."
	exit 1
fi

# Sudo einmal vorab anfordern und die Sitzung offen halten, damit während
# eines langen Downloads keine Passwortabfrage dazwischenfunkt.
if ! (( DRY_RUN )); then
	if ! sudo -v; then
		fail "sudo-Authentifizierung fehlgeschlagen."
		exit 1
	fi
	while true; do
		sudo -n true
		sleep 50
		kill -0 "$$" 2>/dev/null || exit
	done >/dev/null 2>&1 &
	readonly SUDO_KEEPALIVE_PID=$!
	trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null' EXIT
fi

# ------------------------------------------------- 1. TPM-Entsperrung (LUKS)

if (( TPM_ONLY )); then
	SKIP_TPM=0
	tpm_step "TPM-Entsperrung (LUKS)"
	finish
	exit 0
fi

tpm_step "1/5  TPM-Entsperrung (LUKS)"

# ------------------------------------------------------- 2. RPM-Pakete (dnf)

section "2/5  Systempakete (dnf)"

if command -v dnf >/dev/null 2>&1; then
	dnf_args=(upgrade --refresh)
	(( ASSUME_YES )) && dnf_args+=(-y)
	if run sudo dnf "${dnf_args[@]}"; then
		ok "Systempakete aktualisiert"
		RESULTS+=("dnf: OK")
	else
		fail "dnf upgrade mit Fehler beendet"
		RESULTS+=("dnf: FEHLER")
	fi

	# Verwaiste Abhängigkeiten aufräumen
	if (( ASSUME_YES )); then
		run sudo dnf autoremove -y >/dev/null && info "Verwaiste Pakete entfernt"
	fi

	# Prüfen, ob ein Neustart nötig ist (Kernel, systemd, glibc, ...)
	if command -v needs-restarting >/dev/null 2>&1; then
		needs-restarting -r >/dev/null 2>&1 || REBOOT_NEEDED=1
	fi
else
	warn "dnf nicht gefunden – übersprungen"
	RESULTS+=("dnf: n/v")
fi

# --------------------------------------------------------- 3. Flatpak-Apps

section "3/5  Flatpak-Anwendungen"

if command -v flatpak >/dev/null 2>&1; then
	# flatpak darf hier nie selbst nachfragen: Durch die Ausgabe über tee
	# sieht es kein Terminal, wertet seine [Y/n]-Abfrage als «n» und bricht
	# mit Fehler ab. Darum zuerst selbst prüfen und bestätigen lassen, danach
	# nicht-interaktiv aktualisieren.
	info "Suche nach Aktualisierungen …"
	fp_updates=$(flatpak remote-ls --updates --columns=application,branch,origin 2>/dev/null)

	if [[ -z "$fp_updates" ]]; then
		ok "Alle Flatpaks sind aktuell"
		RESULTS+=("flatpak: aktuell")
	else
		fp_count=$(grep -c . <<<"$fp_updates")
		printf '\n'
		printf '%s\n' "$fp_updates" | column -t 2>/dev/null || printf '%s\n' "$fp_updates"
		printf '\n'
		log "$fp_updates"

		if (( DRY_RUN )) || ask "${fp_count} Flatpak-Aktualisierung(en) installieren?"; then
			if run flatpak update -y --noninteractive; then
				ok "Flatpaks aktualisiert"
				RESULTS+=("flatpak: OK")
			else
				fail "flatpak update mit Fehler beendet"
				RESULTS+=("flatpak: FEHLER")
			fi
		else
			info "Flatpak-Update ausgelassen"
			RESULTS+=("flatpak: verfügbar, nicht installiert")
		fi
	fi

	# Nicht mehr benötigte Runtimes entfernen – die sammeln sich sonst an
	# und belegen schnell mehrere Gigabyte.
	if (( ASSUME_YES )); then
		run flatpak uninstall --unused -y --noninteractive >/dev/null && info "Ungenutzte Runtimes entfernt"
	else
		if ask "Ungenutzte Flatpak-Runtimes entfernen?"; then
			run flatpak uninstall --unused -y --noninteractive
		fi
	fi
else
	warn "flatpak nicht gefunden – übersprungen"
	RESULTS+=("flatpak: n/v")
fi

# ------------------------------------------------------------- 4. Firmware

section "4/5  Firmware (fwupd)"

if (( SKIP_FIRMWARE )); then
	info "Auf Wunsch übersprungen (--no-firmware)"
	RESULTS+=("firmware: übersprungen")
elif command -v fwupdmgr >/dev/null 2>&1; then
	run fwupdmgr refresh --force >/dev/null 2>&1 || true

	if fwupdmgr get-updates >/dev/null 2>&1; then
		printf '\n'
		fwupdmgr get-updates 2>/dev/null | tee -a "$LOGFILE"
		printf '\n'

		# Firmware-Updates brauchen Netzstrom und einen Neustart, darum
		# hier bewusst eine eigene Rückfrage.
		if on_ac=$(cat /sys/class/power_supply/A{C,DP}*/online 2>/dev/null | head -1); then
			if [[ "$on_ac" != "1" ]]; then
				warn "Kein Netzteil angeschlossen – Firmware-Update wird nicht empfohlen."
			fi
		fi

		# Schutz für TPM-gebundene LUKS-Geräte: Ein Firmware-Update kann PCR 7
		# verändern. Ohne Passphrase oder Recovery-Key als Rückfallebene wäre
		# das System danach nicht mehr zu entsperren – dann gar nicht erst
		# aktualisieren.
		fw_allowed=1
		for dev in "${TPM_DEVICES[@]}"; do
			if ! tpm_has_fallback "$dev"; then
				fail "$dev ist nur über das TPM entsperrbar – ein Firmware-Update könnte das System unzugänglich machen."
				info "Zuerst einen Wiederherstellungsschlüssel anlegen und sicher aufbewahren:"
				info "  sudo systemd-cryptenroll --recovery-key $dev"
				fw_allowed=0
			fi
		done
		if (( fw_allowed && ${#TPM_DEVICES[@]} )); then
			warn "Die Festplatte ist an das TPM gebunden. Nach dem Neustart wird die LUKS-Passphrase unter Umständen einmalig abgefragt."
			info "Danach «fedora-update --tpm-check» ausführen (oder einfach den nächsten Update-Lauf), um das TPM neu einzurichten."
		fi

		if (( ! fw_allowed )); then
			info "Firmware-Update aus Sicherheitsgründen ausgelassen"
			RESULTS+=("firmware: blockiert – kein LUKS-Passwort/Recovery-Key")
		elif ask "Firmware jetzt aktualisieren? (Neustart erforderlich)"; then
			fw_args=(update)
			(( ASSUME_YES )) && fw_args+=(-y --no-reboot-check)
			if run sudo fwupdmgr "${fw_args[@]}"; then
				ok "Firmware eingespielt"
				RESULTS+=("firmware: OK – Neustart nötig")
				(( ${#TPM_DEVICES[@]} )) && RESULTS+=("tpm: nach Neustart «fedora-update --tpm-check» ausführen")
				REBOOT_NEEDED=1
			else
				fail "Firmware-Update mit Fehler beendet"
				RESULTS+=("firmware: FEHLER")
			fi
		else
			info "Firmware-Update ausgelassen"
			RESULTS+=("firmware: verfügbar, nicht installiert")
		fi
	else
		ok "Keine Firmware-Updates verfügbar"
		RESULTS+=("firmware: aktuell")
	fi
else
	warn "fwupdmgr nicht gefunden – übersprungen"
	RESULTS+=("firmware: n/v")
fi

# ------------------------------------------------- 5. Discover synchronisieren

section "5/5  Discover-Cache abgleichen"

# Discover führt einen eigenen Cache und bekommt Terminal-Updates nicht mit.
# Ohne diesen Schritt zeigt der Notifier veraltete Update-Zahlen an und
# bleibt beim Aktualisieren hängen.
if command -v plasma-discover >/dev/null 2>&1; then
	if ! (( DRY_RUN )); then
		kquitapp6 DiscoverNotifier >/dev/null 2>&1 || true
		pkill -x plasma-discover >/dev/null 2>&1 || true
		sleep 1

		rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/discover" \
		       "${XDG_CACHE_HOME:-$HOME/.cache}/appstream" \
		       "${XDG_CACHE_HOME:-$HOME/.cache}/flatpak/system-cache" 2>/dev/null || true

		command -v appstreamcli >/dev/null 2>&1 && appstreamcli refresh --force >/dev/null 2>&1

		# Notifier abgekoppelt wieder starten, damit er nicht am Script hängt
		if command -v DiscoverNotifier >/dev/null 2>&1; then
			(setsid DiscoverNotifier >/dev/null 2>&1 &)
		fi
	fi
	ok "Discover-Cache zurückgesetzt"
	RESULTS+=("discover: synchronisiert")
else
	info "Discover nicht installiert – nichts abzugleichen"
fi

finish
